generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LibertadoraProspecto {
  id        Int      @id @default(autoincrement())
  empresa   String
  producto  String   @default("PORTAFOLIO")
  gestion   String?
  estado    String   @default("EN_PROCESO")
  monto     Int      @default(0)
  prioridad String   @default("MEDIA")
  accion    String?
  fecha     String?
  trimestre String?
  tipo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LibertadoraCita {
  id        Int      @id @default(autoincrement())
  cliente   String
  fecha     String
  hora      String   @default("09:00")
  modalidad String   @default("Presencial")
  producto  String   @default("PORTAFOLIO")
  estado    String   @default("pending")
  notas     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Fila única (id=1) — metas comerciales configurables desde Configuración.
model LibertadoraMeta {
  id          Int      @id @default(1)
  metaMensual Int?
  metaAnual   Int?
  metaCierres Int?
  metaCitas   Int?
  updatedAt   DateTime @updatedAt
}

// Usuario de esta app standalone (staff Y socio externo Skandia por igual —
// decisión del usuario, 2026-07-28: al sacar el módulo completo de la
// intranet, ambos entran con el mismo tipo de cuenta, sin depender del JWT
// de la intranet para nada). `isAdmin` puede crear/desactivar/resetear
// contraseña de otras cuentas; el resto solo usa la app. Contraseña la fija
// un admin a mano, sin flujo de recuperación por correo por ahora.
model LibertadoraUser {
  id           String    @id @default(uuid())
  email        String    @unique
  nombre       String?
  passwordHash String
  isAdmin      Boolean   @default(false)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
}
