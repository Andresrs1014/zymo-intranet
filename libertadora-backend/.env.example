NODE_ENV=production
PORT=3006
DATABASE_URL=postgresql://libertadora:your-secure-db-password@libertadora-db:5432/libertadoradb
# Propio de esta app, ya NO es el JWT_SECRET de la intranet — genera uno nuevo, random, solo para esto.
JWT_SECRET=change-me-generate-a-real-random-secret
# URL del frontend en Cloudflare Pages una vez creado, ej. https://libertadora-crm.pages.dev
CORS_ORIGIN=http://localhost:5173
