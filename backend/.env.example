# ── Intranet Core ─────────────────────────────────────────────────────────────
SECRET_KEY=cambia-esto-por-un-secreto-seguro-de-32-chars
DATABASE_URL=sqlite:///./data/intranet.db
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Admin inicial (solo se crea si no existe ningún admin)
FIRST_ADMIN_EMAIL=admin@zymo.com
FIRST_ADMIN_PASSWORD=Admin123*

# Entorno: "development" | "production"
# En producción: activa validaciones de seguridad extra
ENVIRONMENT=production

# CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,https://zymointranet.com,https://oc.zymointranet.com

# ── Borradores de formularios ─────────────────────────────────────────────────
DRAFTS_DIR=/app/data/form_drafts
DRAFT_TTL_DAYS=7

# ── Motor de Extracción IA ────────────────────────────────────────────────────
# Directorio donde se guardan los resultados de Fase 2 para poll del frontend
PHASE2_RESULTS_DIR=/app/data/extraction_phase2

# ── Anthropic / Claude (analizadores SIG — la clave NUNCA sale del servidor) ──
# Requerido para que funcionen los analizadores en la intranet (coherencia, mejoras, etc.)
ANTHROPIC_API_KEY=

# ── OC Automatizaciones ───────────────────────────────────────────────────────
OC_DATABASE_URL=sqlite:///./data/oc.db

