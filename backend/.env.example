# ── Intranet Core ─────────────────────────────────────────────────────────────
SECRET_KEY=cambia-esto-por-un-secreto-seguro-de-32-chars
DATABASE_URL=sqlite:///./data/intranet.db
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Admin inicial (solo se crea si no existe ningún admin)
FIRST_ADMIN_EMAIL=admin@zymo.com
FIRST_ADMIN_PASSWORD=Admin123*

# Entorno: "development" | "production"
# En producción: activa validaciones de seguridad extra (webhook secret obligatorio, etc.)
ENVIRONMENT=production

# CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,https://zymointranet.com,https://oc.zymointranet.com

# ── Borradores de formularios ─────────────────────────────────────────────────
DRAFTS_DIR=/app/data/form_drafts
DRAFT_TTL_DAYS=7

# ── OC Automatizaciones ───────────────────────────────────────────────────────
OC_DATABASE_URL=sqlite:///./data/oc.db

# Secret para validar que el webhook viene de Power Automate
# Déjalo vacío durante desarrollo. En producción ponlo en PA y aquí igual.
OC_WEBHOOK_SECRET=

# ── Agentes IA ────────────────────────────────────────────────────────────────
AGENTS_DATABASE_URL=sqlite:///./data/agents.db

# API Key de Gemini — una sola cuenta (1M tokens/día gratis en Free Tier)
GEMINI_API_KEY=

# Perplexity — solo para noticias IA del módulo gerencial
PERPLEXITY_API_KEY=

# Configuración de agentes
AGENT_CHECK_INTERVAL_MINUTES=120
AGENT_DOCS_DIR=/app/data/agent_docs
AGENT_LOGS_DIR=/app/data/agent_logs
AGENT_MEMORY_DIR=/app/data/agent_memory
LIGHTRAG_WORKING_DIR=/app/data/lightrag

# ── Ollama (embeddings locales — no requiere API key) ─────────────────────────
# URL del servidor Ollama. Si corre en el mismo servidor: http://localhost:11434
# Si Ollama está en otro host: http://192.168.x.x:11434
OLLAMA_BASE_URL=http://localhost:11434
# Modelo de embeddings. Recomendado: nomic-embed-text (768 dims, ~274MB)
OLLAMA_EMBED_MODEL=nomic-embed-text
