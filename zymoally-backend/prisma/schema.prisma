generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tickets (PQR) ─────────────────────────────────────────────────────────

model ZymoPqrTicket {
  id                 Int               @id @default(autoincrement())
  code               String            @unique
  createdAt          DateTime          @default(now())
  monthKey           String
  area               String
  areaPrefix         String
  client             String?
  platform           String?
  supervisor         String?
  supervisorEmail    String?
  analysts           String[]          @default([])
  analystEmails      String[]          @default([])
  coordinator        String?
  coordinatorEmail   String?
  manager            String?
  managerEmail       String?
  phone              String?
  email              String?
  owner              String?
  date               String
  dueDate            String?
  type               String
  status             String
  priority           String
  impact             String?
  channel            String?
  managementCriteria String?
  closedDate         String?
  closedAt           DateTime?
  description        String?
  // Flujo por etapas (supervisor asigna -> analista gestiona -> gerencia
  // valida). originalAnalyst* es un snapshot inmutable del primer analista
  // asignado — analysts/analystEmails de arriba sigue siendo la lista VIVA,
  // editable por el supervisor (puede sumar/quitar gente después).
  originalAnalysts      String[]  @default([])
  originalAnalystEmails String[]  @default([])
  assignedAt            DateTime?
  readyForValidationAt  DateTime?
  validatedBy           String?
  validatedByEmail      String?
  // Fase F — recordatorios de 1 mes sin gestionar (día 7/15/22/30 desde
  // createdAt). Guarda el último hito ya notificado para no re-enviar y para
  // seguir alcanzando el siguiente hito aunque el cron se salte un día.
  lastReminderDay    Int               @default(0)
  actions            ZymoPqrAction[]
  evidence           ZymoPqrEvidence[]
}

model ZymoPqrAction {
  id        Int           @id @default(autoincrement())
  ticketId  Int
  ticket    ZymoPqrTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  texto     String

  @@index([ticketId])
}

model ZymoPqrEvidence {
  id        Int           @id @default(autoincrement())
  ticketId  Int
  ticket    ZymoPqrTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  filename  String
  url       String?

  @@index([ticketId])
}

model ZymoConfigList {
  id           Int       @id @default(autoincrement())
  listType     String
  value        String
  label        String
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  externalId   String?
  syncedAt     DateTime?
  contactEmail String?
  contactPhone String?
  slaHours     Int?      // solo aplica a listType="priorities" — horas laborales límite de gestión

  @@unique([listType, value])
  @@index([listType])
}

// Links cortos (ej. "Enviar encuesta" en SAC) — el token del magic-link es
// un JWT, largo por naturaleza; acá se guarda solo el mapeo code -> url real.
model ZymoShortLink {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  url       String
  createdAt DateTime @default(now())
}

model ZymoAreaPrefix {
  id         Int       @id @default(autoincrement())
  area       String
  prefix     String    @unique
  isActive   Boolean   @default(true)
  sortOrder  Int       @default(0)
  externalId String?
  syncedAt   DateTime?
}

// ─── SAC (Servicio al Cliente) ─────────────────────────────────────────────

model ZymoClientSurvey {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  date          String
  company       String?
  role          String?
  email         String?
  phone         String?
  nps           Int
  npsCategory   String
  satisfaction  Int
  delivery      Int
  attention     Int
  meeting       Int
  solution      Int
  valuedAspect  String?
  issue         String?
  comment       String?
  nextStep      String?
}

model ZymoExperienceSurvey {
  id                       Int      @id @default(autoincrement())
  createdAt                DateTime @default(now())
  date                     String
  company                  String?
  contact                  String?
  email                    String?
  phone                    String?
  fit                      String?
  futureValue              Int
  clarity                  String?
  exceededExpectations     String?
  actionToday              String?
  professionalSatisfaction Int
  meetingFit               Int
  leadershipComment        String?
  satisfaction             Int
  solution                 Int
  nextStep                 String?
}

model ZymoVisitReport {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  date         String
  commercial   String?
  client       String
  contact      String?
  outcome      String?
  nextDate     String?
  quality      Int
  clientMood   Int
  opportunity  Int
  urgency      Int
  observations String?
  actionPlan   String?
}
