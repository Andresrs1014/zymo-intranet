generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HelixProyecto {
  id           Int                @id @default(autoincrement())
  nombre       String
  subproyectos HelixSubproyecto[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model HelixSubproyecto {
  id           Int               @id @default(autoincrement())
  // Requerido cuando tipo="Subproyecto" (iniciativa real, con caso de negocio).
  // Nulo cuando tipo="PlanDeTrabajo" — es una herramienta táctica rápida, no
  // pertenece a un Proyecto principal ni carga ROI (regla de negocio en el
  // service, no en el schema — ver actividadService/planTrabajoService).
  proyectoId   Int?
  proyecto     HelixProyecto?    @relation(fields: [proyectoId], references: [id])
  tipo         String            @default("Subproyecto") // Subproyecto | PlanDeTrabajo
  nombre       String
  objetivo     String?
  cliente      String?
  inversionEst Float             @default(0)
  retornoEsp   Float             @default(0)
  activo       Boolean           @default(true)
  actividades  HelixActividad[]
  alertas      HelixAlerta[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

// Catálogo de dependencias externas (bloqueo informativo: cliente, proveedor, etc.)
// Distinto de HelixActividad.bloqueada, que marca bloqueo real de la actividad.
model HelixDependencia {
  id              Int              @id @default(autoincrement())
  nombre          String
  tipo            String           @default("Interna") // Interna | Externa | Cliente | Tecnologia | Proveedor
  responsableArea String?
  actividades     HelixActividad[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model HelixActividad {
  id                  Int               @id @default(autoincrement())
  subproyectoId       Int
  subproyecto         HelixSubproyecto  @relation(fields: [subproyectoId], references: [id], onDelete: Cascade)
  numeroActividad     String?
  responsableId       Int
  responsableNombre   String
  responsableInitials String
  responsableColor    String            @default("#5461c8")
  nombre              String
  estado              String            @default("Backlog")
  prioridad           String            @default("Media")
  fechaInicio         DateTime
  fechaFin            DateTime
  avance              Int               @default(0)
  puntos              Int               @default(3)
  costoInversion      Float             @default(0)
  costoOptimizacion   Float             @default(0)
  costoEjecucion      Float             @default(0)
  bloqueada           Boolean           @default(false)
  dependenciaId       Int?
  dependencia         HelixDependencia? @relation(fields: [dependenciaId], references: [id])
  completadaEn        DateTime?
  subactividades      HelixSubactividad[]
  comentarios         HelixComentario[]
  evidencias          HelixEvidencia[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model HelixSubactividad {
  id                Int            @id @default(autoincrement())
  actividadId       Int
  actividad         HelixActividad @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  nombre            String
  responsableId     Int?
  responsableNombre String?
  estado            String         @default("Planificado")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model HelixComentario {
  id          Int            @id @default(autoincrement())
  actividadId Int
  actividad   HelixActividad @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  autorId     Int
  autorNombre String
  texto       String
  canal       String         @default("web")
  createdAt   DateTime       @default(now())
}

model HelixEvidencia {
  id          Int            @id @default(autoincrement())
  actividadId Int
  actividad   HelixActividad @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  nombre      String
  tipoArchivo String
  tamanio     Int
  ruta        String
  createdAt   DateTime       @default(now())
}

model HelixEncuesta {
  id            Int      @id @default(autoincrement())
  usuarioId     Int
  usuarioNombre String
  rol           String
  satisfaccion  Int
  facilidad     Int
  utilidad      Int
  nps           Int
  comentario    String?
  createdAt     DateTime @default(now())
}

model HelixAlerta {
  id              Int               @id @default(autoincrement())
  subproyectoId   Int?
  subproyecto     HelixSubproyecto? @relation(fields: [subproyectoId], references: [id], onDelete: SetNull)
  cambio          String
  actividadId     Int?
  actividadNombre String?
  destinatarios   Json
  canal           String
  createdAt       DateTime          @default(now())
}

model HelixAIConversacion {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  mensajes  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
