generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Áreas de procedimientos (creadas por admin, BD inicia vacía) ──────────────

model SigArea {
  id             Int                @id @default(autoincrement())
  nombre         String
  descripcion    String?
  color          String             @default("#3b82f6")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  procedimientos SigProcedimiento[]
}

// ── Procedimiento (el "repositorio" de un documento) ──────────────────────────

model SigProcedimiento {
  id          Int                    @id @default(autoincrement())
  areaId      Int
  area        SigArea                @relation(fields: [areaId], references: [id])
  codigo      String                 @unique
  titulo      String
  descripcion String?
  estado      SigEstadoProcedimiento @default(BORRADOR)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  commits              SigCommit[]
  instructivos         SigInstructivo[]
  formatos             SigFormato[]
  docAnexos            SigDocAnexo[]
  cargosInvolucrados   SigProcedimientoCargo[]
  auditorias           SigAnalisisAuditoria[]
  hallazgos            SigHallazgo[]
  consultas            SigConsulta[]
  protocolos           SigProtocolo[]
  referencias          SigReferencia[]

  @@index([areaId])
  @@index([estado])
}

enum SigEstadoProcedimiento {
  BORRADOR
  VIGENTE
  OBSOLETO
}

// ── Commit — antes vs después del agente de análisis IA ────────────────────────

model SigCommit {
  id               Int                @id @default(autoincrement())
  procedimientoId  Int
  procedimiento    SigProcedimiento   @relation(fields: [procedimientoId], references: [id], onDelete: Cascade)

  // Par de diff: texto original del doc vs lo que procesó el agente
  contenidoOriginal String            @db.Text
  contenidoAgente   String            @db.Text
  flujogramaMmd     String?           @db.Text
  flujogramaImagenUrl String?         @db.VarChar(255) // imagen original del flujograma extraída del docx (ver textExtraction.ts)
  sinCambios        Boolean           @default(false)

  // Metadata del commit
  mensaje          String
  autorId          Int
  autorNombre      String
  versionDoc       String?            // versión del doc original ("v3", "17", etc.)

  // Revisión del Gerente
  estado           SigEstadoCommit    @default(PENDIENTE_REVISION)
  aprobadoPor      Int?
  aprobadoNombre   String?
  aprobadoEn       DateTime?
  comentarioRevision String?          @db.Text

  // Archivo original adjunto al commit (PDF, DOCX, DOC, MD)
  archivoOriginal  String?            @db.VarChar(500)
  nombreArchivo    String?            @db.VarChar(255)
  tipoMime         String?            @db.VarChar(100)

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  auditorias       SigAnalisisAuditoria[]
  hallazgos        SigHallazgo[]

  @@index([procedimientoId])
  @@index([estado])
  @@index([createdAt])
}

enum SigEstadoCommit {
  PENDIENTE_REVISION
  APROBADO
  RECHAZADO
}

// ── Instructivo — documento de soporte de un procedimiento ────────────────────

model SigInstructivo {
  id              Int              @id @default(autoincrement())
  procedimientoId Int
  procedimiento   SigProcedimiento @relation(fields: [procedimientoId], references: [id], onDelete: Cascade)

  codigo          String
  titulo          String
  descripcion     String?

  contenido         String  @db.Text
  contenidoOriginal String? @db.Text
  versionDoc        String  @default("1.0")

  archivoOriginal   String? @db.VarChar(500)
  nombreArchivo     String? @db.VarChar(255)
  tipoMime          String? @db.VarChar(100)

  autorId     Int
  autorNombre String

  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  formatos SigFormato[]

  @@index([procedimientoId])
  @@index([codigo])
}

// ── Formato — plantilla/formulario a nivel de procedimiento; puede asociarse
// a un instructivo puntual para más contexto, pero no es obligatorio ──────────

model SigFormato {
  id              Int              @id @default(autoincrement())
  procedimientoId Int
  procedimiento   SigProcedimiento @relation(fields: [procedimientoId], references: [id], onDelete: Cascade)
  instructivoId   Int?
  instructivo     SigInstructivo?  @relation(fields: [instructivoId], references: [id], onDelete: SetNull)

  nombre  String
  archivo String @db.VarChar(500)
  nombreArchivo String @db.VarChar(255)
  tipoMime      String? @db.VarChar(100)

  autorId     Int
  autorNombre String

  createdAt DateTime @default(now())

  @@index([instructivoId])
  @@index([procedimientoId])
}

// ── Doc Anexo — documento adicional libre a nivel de procedimiento ────────────
// Sin categoría fija: cualquier documento adicional que el procedimiento
// necesite adjuntar y que no encaje como instructivo ni formato.

model SigDocAnexo {
  id              Int              @id @default(autoincrement())
  procedimientoId Int
  procedimiento   SigProcedimiento @relation(fields: [procedimientoId], references: [id], onDelete: Cascade)

  nombre  String
  archivo String @db.VarChar(500)
  nombreArchivo String @db.VarChar(255)
  tipoMime      String? @db.VarChar(100)

  autorId     Int
  autorNombre String

  createdAt DateTime @default(now())

  @@index([procedimientoId])
}

// ── Archivo pendiente — pool de carga masiva sin asignar ──────────────────────
// Se sube el archivo suelto (botón "Subir procedimientos" o "Subir documentos de
// soporte") sin decir todavía a qué procedimiento pertenece. Queda estático acá
// hasta que alguien lo asigna a mano (uno por uno o varios a la vez a un mismo
// procedimiento). `origen` distingue si lo subió la intranet o el MCP-001 (mismo
// endpoint, servido por requireSigAccess — el rol IA_SIG ya tiene mod_sig).
model SigArchivoPendiente {
  id              Int      @id @default(autoincrement())
  archivoOriginal String   @db.VarChar(500) // nombre de archivo en uploads/sig (igual que SigCommit)
  nombreArchivo   String   @db.VarChar(255)
  tipoMime        String?  @db.VarChar(100)
  tamanoBytes     Int
  categoria       String   @db.VarChar(20) // "procedimiento" | "soporte"
  origen          String   @default("intranet") @db.VarChar(20) // "intranet" | "mcp"
  subidoPorId     Int?
  subidoPorNombre String

  asignado        Boolean   @default(false)
  asignadoEn      DateTime?
  asignadoTipo    String?   @db.VarChar(20) // "procedimiento" | "instructivo" | "formato" | "doc_anexo"
  // Referencias de trazabilidad al registro creado al asignar -- sin relación
  // formal (el destino puede vivir en cualquiera de 4 tablas distintas).
  commitId        Int?
  instructivoId   Int?
  formatoId       Int?
  docAnexoId      Int?

  createdAt DateTime @default(now())

  @@index([categoria, asignado])
  @@index([createdAt])
}

// ── Cargos T&C asignados a un procedimiento (para análisis IA) ───────────────

model SigProcedimientoCargo {
  id              Int              @id @default(autoincrement())
  procedimientoId Int
  procedimiento   SigProcedimiento @relation(fields: [procedimientoId], references: [id], onDelete: Cascade)
  cargoId         Int              // ID en ptc_cargo (BD personal / T&C)
  cargoNombre     String           @db.VarChar(150)
  createdAt       DateTime         @default(now())

  @@unique([procedimientoId, cargoId])
  @@index([procedimientoId])
  @@index([cargoId])
}

// ── Auditoría del agente analista (multiagente MCP-001) ──────────────────────
// Un registro por corrida del agente analista sobre un procedimiento. NO usa
// score/porcentaje: veredicto de auditoría (pasa / no_pasa / incompleto)
// derivado en el servidor a partir de la clasificación de los hallazgos.
// Ver C:\Gestion_documental\rubrica\rubrica_sig.md.

model SigAnalisisAuditoria {
  id              Int              @id @default(autoincrement())
  procedimientoId Int
  procedimiento   SigProcedimiento @relation(fields: [procedimientoId], references: [id], onDelete: Cascade)
  commitId        Int?             // versión del documento analizada
  commit          SigCommit?       @relation(fields: [commitId], references: [id], onDelete: SetNull)

  veredicto           String  // "pasa" | "no_pasa" | "incompleto" (derivado en el servidor)
  veredictoPorFuncion Json    @default("{}")   // { "1.1": "pasa", "1.2": "no_pasa", ... }
  conteo              Json    @default("{}")   // { ncMayor, ncMenor, observacion, oportunidadMejora, conformidad, consulta }
  resumenEjecutivo    String  @db.Text
  reporteMarkdown     String  @db.Text
  normas              Json    @default("[]")   // ["ISO 9001", "BASC"]
  alcanceArchivos     Json    @default("[]")   // documentos que entraron al análisis
  // Rúbrica §6.2: plan de auditoría, comprensión y seguimiento de la corrida.
  alcance           Json    @default("{}")   // { tipo, documentos[], periodoKpi, muestra }
  criterios         Json    @default("[]")   // [{ id, tipo, fuente, referencia }]
  comprensionProceso String? @db.Text
  supuestos         Json    @default("[]")
  recomendaciones   String? @db.Text         // solo si el usuario las pidió (§0.7)
  seguimiento       Json    @default("[]")   // una entrada por hallazgo abierto previo (§8)

  // Autoría: la cuenta IA (rol IA_SIG) ejecuta; el operador humano dispara; y luego valida.
  autorId        Int
  autorNombre    String
  operadorId     Int?
  operadorNombre String?
  validadoPorId  Int?
  validadoNombre String?
  validadoEn     DateTime?

  modelosUsados Json @default("[]")
  tokensUsados  Int?

  createdAt DateTime @default(now())

  hallazgos SigHallazgo[]
  consultas SigConsulta[]

  @@index([procedimientoId])
  @@index([commitId])
  @@index([createdAt])
}

// ── Hallazgo — entidad con ciclo de vida propio, atada a la versión ──────────
// El agente es dueño del ciclo: al re-analizar una versión nueva cierra los
// hallazgos que esa versión resuelve (con evidencia). Ver rúbrica §8.

model SigHallazgo {
  id              Int                  @id @default(autoincrement())
  procedimientoId Int
  procedimiento   SigProcedimiento     @relation(fields: [procedimientoId], references: [id], onDelete: Cascade)
  auditoriaId     Int
  auditoria       SigAnalisisAuditoria @relation(fields: [auditoriaId], references: [id], onDelete: Cascade)
  commitId        Int?                 // versión contra la que se levantó
  commit          SigCommit?           @relation(fields: [commitId], references: [id], onDelete: SetNull)

  funcion       String  // "1.1" … "1.6"
  nivel         Int     // 1 = comprensión humana, 2 = norma
  clasificacion String  // "conformidad" | "observacion" | "oportunidad_mejora" | "nc_menor" | "nc_mayor"
  fragmento     String  @db.Text
  archivo       String?
  tipoDocumento String?                  // caracterizacion | procedimiento | instructivo | formato | …
  criterio      String?                  // id dentro de SigAnalisisAuditoria.criterios
  condicion     String? @db.Text         // brecha entre criterio y evidencia
  descripcion   String  @db.Text
  demostracion  Json    @default("{}")   // { tipo: contradiccion|clausula|regla_funcion|kpi, detalle, citasEnConflicto[] }
  palabra       Json?                    // sub-formato §1.2 (2 definiciones) cuando funcion = "1.2"
  kpi           Json?                    // cuando funcion = "1.6": { nombre, objetivo, meta, periodo, resultado, fuenteDato }
  impacto       String? @db.Text
  riesgo        Json?                    // { impacto, probabilidad, efectividadControl, prioridad, justificacion }
  causa         Json?                    // { tipo: evidenciada|hipotesis, detalle }
  dedupeKey     String

  estado          String    @default("ABIERTO")  // "ABIERTO" | "CERRADO" | "CONFORME"
  motivoCierre    String?   @db.Text
  evidenciaCierre String?   @db.Text               // fragmento nuevo que corrige el problema
  sustituyeA      Int?                             // id del hallazgo previo que este reemplaza
  cerradoPorId    Int?
  cerradoNombre   String?
  cerradoEn       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([procedimientoId, estado])
  @@index([auditoriaId])
  @@index([dedupeKey])
}

// ── Consulta — el agente necesita algo del usuario para poder juzgar ─────────
// Documento faltante (§5.A) o contexto operativo confuso (§5.B). Mientras haya
// consultas ABIERTAS el veredicto queda "incompleto".

model SigConsulta {
  id              Int                  @id @default(autoincrement())
  procedimientoId Int
  procedimiento   SigProcedimiento     @relation(fields: [procedimientoId], references: [id], onDelete: Cascade)
  auditoriaId     Int
  auditoria       SigAnalisisAuditoria @relation(fields: [auditoriaId], references: [id], onDelete: Cascade)

  tipo              String  // "documento_faltante" | "contexto_operativo" | "dato_kpi"
  funcion           String
  datos             Json?   // dato_kpi: { kpi, faltante, periodo }
  fragmento         String? @db.Text
  documentoEsperado String?
  motivo            String? @db.Text
  preguntas         Json    @default("[]")

  estado           String   @default("ABIERTA")  // "ABIERTA" | "RESUELTA"
  respuestaUsuario String?  @db.Text
  // "sin_hallazgo" | "observacion" | "nc_menor" | "nc_mayor" | "otro_nombre" | "indexado"
  resolucion       String?
  resueltoPorId    Int?
  resueltoNombre   String?
  resueltoEn       DateTime?

  createdAt DateTime @default(now())

  @@index([procedimientoId, estado])
  @@index([auditoriaId])
}

// ── Protocolo — documento con casa en un procedimiento. Las demás citas
// (otro procedimiento, un instructivo) viven en SigReferencia, no como segundo padre.
// Lo consume el MCP (mcp001): sig_upload_area_folder y sig_review_context. Portado del PR #17.

model SigProtocolo {
  id              Int              @id @default(autoincrement())
  procedimientoId Int
  procedimiento   SigProcedimiento @relation(fields: [procedimientoId], references: [id], onDelete: Cascade)

  codigo          String
  titulo          String
  descripcion     String?

  contenido         String  @db.Text
  contenidoOriginal String? @db.Text
  versionDoc        String  @default("1.0")

  archivoOriginal   String? @db.VarChar(500)
  nombreArchivo     String? @db.VarChar(255)
  tipoMime          String? @db.VarChar(100)

  autorId     Int
  autorNombre String

  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([procedimientoId, codigo])
  @@index([procedimientoId])
  @@index([codigo])
}

// ── Referencia — "esto cita aquello", aunque el destino no exista o sea de otra área.
// La casa del archivo sigue siendo un solo padre. destinoId queda vacío si el
// archivo no está (ausente) o todavía no se abrió (otra_area).

model SigReferencia {
  id              Int              @id @default(autoincrement())
  procedimientoId Int
  procedimiento   SigProcedimiento @relation(fields: [procedimientoId], references: [id], onDelete: Cascade)

  origenTipo    String  @db.VarChar(20) // procedimiento | instructivo | protocolo | formato
  origenId      Int
  destinoTipo   String  @db.VarChar(20) // procedimiento | instructivo | protocolo | formato | area
  destinoCodigo String  @db.VarChar(80)
  destinoId     Int?
  estado        String  @db.VarChar(20) // resuelta | ausente | otra_area | otro_codigo
  nota          String? @db.Text
  frase         String? @db.Text

  createdAt DateTime @default(now())

  @@unique([origenTipo, origenId, destinoTipo, destinoCodigo])
  @@index([procedimientoId])
}

// ── Reportes de Desarrollo ────────────────────────────────────────────────────
// Reportes semanales que sube el equipo de desarrollo documentando el trabajo:
// markdown con flujogramas y especificaciones, % de avance y tiempos estimados.
// El archivo .md original se conserva como respaldo (mismo patrón que instructivos).

model SigReporteDesarrollo {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String?  @db.VarChar(1000)
  proyecto    String   // ej. "Helix", "Intranet", "ZymoAlly"
  contenidoMd String   @db.Text
  porcentajeAvance     Int     // 0-100
  tiempoEstimadoHoras  Float?
  tiempoRealHoras      Float?
  fechaReporte         DateTime @default(now())

  // Metadatos de quien lo creó
  autorId     Int
  autorNombre String

  // Archivo original subido (.md). Solo el filename — el directorio base está en el router.
  archivoOriginal String? @db.VarChar(500)
  nombreArchivo   String? @db.VarChar(255)
  tipoMime        String? @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([proyecto])
  @@index([autorId])
  @@index([fechaReporte])
}

