# Vacío = mismo origen (el nginx proxytea al backend)
VITE_API_URL=
# Helix backend — proxiado por nginx en /helix-api/ → helix-backend:3001
VITE_HELIX_API_URL=/helix-api
# Tareas V2 backend — proxiado por nginx en /tareas-api/ → task-backend:3002
VITE_TASK_API_URL=/tareas-api
# Poner en "true" para mostrar el banner de deprecación en la vista V1
VITE_TASKS_V1_DEPRECATED=false
